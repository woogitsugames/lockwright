; Spikes 1-2 (docs/TECH.md §4): haptic latency probe inside Godot (compare with native-ios / native-android).
config_version=5

[application]

config/name="Lockwright Spike 1-2 Haptics Probe"
config/description="Spike: haptics latency. Not game code."
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.1, 0.094, 0.086, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=412
window/size/viewport_height=915
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/lockwright_haptics_probe/plugin.cfg")

[input_devices]

buffering/agile_event_flushing=true
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
