# Build the LockwrightHaptics iOS plugin (shared .dylib for the .gdextension xcframework, D-30) with godot-cpp 4.7.
# Usage (macOS): GODOT_CPP_SCONSTRUCT=<godot-cpp>/SConstruct scons platform=ios target=template_release arch=arm64
import os

env = SConscript(os.environ.get("GODOT_CPP_SCONSTRUCT", "godot-cpp/SConstruct"))

cpp_sources = Glob("Sources/*.cpp")
mm_sources = Glob("Sources/*.mm")

env.Append(CPPPATH=["include"], CXXFLAGS=["-miphoneos-version-min=18.0"])

# godot-cpp builds static (non-PIC) objects for ios; the shared .dylib target needs PIC objects.
if env["platform"] == "ios":
    env.Append(CCFLAGS=["-fPIC"], CXXFLAGS=["-fPIC"])

# .mm must be compiled as ObjC++: separate env with explicit -x objective-c++.
objc_env = env.Clone()
objc_env.Append(CXXFLAGS=["-x", "objective-c++", "-std=gnu++20", "-fobjc-arc", "-miphoneos-version-min=18.0"])

cpp_objs = env.Object(cpp_sources)
mm_objs = objc_env.Object(mm_sources)

library = env.SharedLibrary(
    "bin/liblockwright_haptics.{}.{}".format(env["platform"], env["target"]),
    cpp_objs + mm_objs,
)
env.Append(LINKFLAGS=["-framework", "CoreHaptics", "-framework", "AVFAudio", "-framework", "Foundation", "-framework", "UIKit"])

Default(library)
