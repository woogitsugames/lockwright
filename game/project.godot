; Engine configuration file.
; Lockwright — Godot 4.7.x (see game/README.md, docs/TECH.md §1)

config_version=5

[application]

config/name="Lockwright"
config/icon="res://icon.svg"
config/description="Lockwright: Emergency Locksmith — premium mobile game. This is a game, not a course."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)
boot_splash/show_image=false
; N-52: Android back is handled by the Nav autoload, never quits directly
config/quit_on_go_back=false

[audio]

general/text_to_speech=true

[autoload]

PerfProbe="*res://scripts/autoload/perf_probe.gd"
DpScale="*res://scripts/autoload/dp_scale.gd"
Settings="*res://scripts/autoload/settings.gd"
Save="*res://scripts/autoload/save.gd"
I18n="*res://scripts/autoload/i18n.gd"
Events="*res://scripts/autoload/events.gd"
Haptics="*res://scripts/autoload/haptics.gd"
FeedbackDirector="*res://scripts/autoload/feedback_director.gd"
UiA11y="*res://scripts/autoload/ui_a11y.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Quality="*res://scripts/autoload/quality.gd"
Achievements="*res://scripts/autoload/achievements.gd"
ErrorLog="*res://scripts/autoload/error_log.gd"
Nav="*res://scripts/autoload/nav.gd"
VoicePacks="*res://scripts/autoload/voice_packs.gd"

[gui]

theme/custom="res://theme/main.tres"

[display]

window/size/viewport_width=412
window/size/viewport_height=915
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[internationalization]

; CSV sources are loaded at runtime by the I18n autoload (works headless and in exports)
locale/fallback="en"

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.5

[rendering]

; perf 2026-11-08: Godot's 128 MB staging pool grows on texture/glyph uploads and is never
; returned (job list on SM-A165F: 330 -> 170 MB of GPU memory with 16 MB); a small pool only stalls uploads
rendering_device/staging_buffer/max_size_mb=16
; perf 2026-11-08: the default 3 MB chunk is never reached in a session, and Android kills the
; app instead of quitting, so user://vulkan stayed empty and every session recompiled its pipelines
rendering_device/pipeline_cache/save_chunk_size_mb=0.25
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.085, 0.065, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/lockwright_haptics/plugin.cfg", "res://addons/lockwright_click_audio/plugin.cfg")
