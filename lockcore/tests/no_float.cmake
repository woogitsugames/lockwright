# Fails if any library source mentions float/double/long double or <cmath>.
set(bad "")
foreach(dir ${DIRS})
  file(GLOB_RECURSE files "${dir}/*.hpp" "${dir}/*.cpp")
  foreach(f ${files})
    file(STRINGS "${f}" lines REGEX "(^|[^A-Za-z_])(float|double)([^A-Za-z_]|$)|<cmath>|<math.h>")
    foreach(l ${lines})
      if(NOT l MATCHES "^[ ]*//")
        list(APPEND bad "${f}: ${l}")
      endif()
    endforeach()
  endforeach()
endforeach()
if(bad)
  string(REPLACE ";" "\n" msg "${bad}")
  message(FATAL_ERROR "floating point found in lockcore:\n${msg}")
endif()
message(STATUS "no floating point in lockcore sources")
